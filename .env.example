# Canonical site URL (used for sitemap, Open Graph, structured data).
# On Netlify, set this to your production domain. If unset, Netlify's built-in URL is used.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL of the folder holding the full-length videos (Cloudflare R2 public URL + folder). Optional; defaults to the R2 bucket in lib/projects.ts.
# NEXT_PUBLIC_VIDEO_BASE=https://pub-xxxx.r2.dev/saikumar-web-videos
