# Canonical site URL (used for sitemap, Open Graph, structured data).
# On Netlify, set this to your production domain. If unset, Netlify's built-in URL is used.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL of the folder holding the full-length videos (Cloudflare R2 public URL + folder). Optional; defaults to the R2 bucket in lib/projects.ts.
# NEXT_PUBLIC_VIDEO_BASE=https://pub-xxxx.r2.dev/saikumar-web-videos

# --- Admin (/admin) ---
# Cloudflare R2 → Manage API tokens (Object Read & Write, this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# The single admin password, and a random 32+ char string (openssl rand -hex 32) used to sign the login cookie
ADMIN_PASSWORD=
SESSION_SECRET=
